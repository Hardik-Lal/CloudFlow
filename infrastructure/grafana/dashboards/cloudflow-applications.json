{
  "uid": "cloudflow-applications",
  "title": "CloudFlow \u00b7 Applications",
  "tags": [
    "cloudflow"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "cloudflow-prometheus"
        },
        "query": {
          "query": "label_values(cloudflow_app_up, project)",
          "refId": "A"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "cloudflow-prometheus"
        },
        "query": {
          "query": "label_values(cloudflow_app_up, environment)",
          "refId": "A"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Services up",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudflow-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cloudflow-prometheus"
          },
          "expr": "sum(cloudflow_app_up{project=~\"$project\",environment=~\"$environment\"})"
        }
      ],
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Restarts (total)",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudflow-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cloudflow-prometheus"
          },
          "expr": "sum(cloudflow_app_restarts{project=~\"$project\",environment=~\"$environment\"})"
        }
      ],
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Health-check error rate (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudflow-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cloudflow-prometheus"
          },
          "expr": "100 * sum(increase(cloudflow_app_health_checks_total{result=\"failure\",project=~\"$project\",environment=~\"$environment\"}[1h])) / clamp_min(sum(increase(cloudflow_app_health_checks_total{project=~\"$project\",environment=~\"$environment\"}[1h])), 1)"
        }
      ],
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU usage",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cloudflow-prometheus"
          },
          "expr": "cloudflow_app_cpu_usage_percent{project=~\"$project\",environment=~\"$environment\"}",
          "legendFormat": "{{project}} \u00b7 {{environment}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Memory usage",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cloudflow-prometheus"
          },
          "expr": "cloudflow_app_memory_usage_bytes{project=~\"$project\",environment=~\"$environment\"}",
          "legendFormat": "{{project}} \u00b7 {{environment}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Health-check response time",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cloudflow-prometheus"
          },
          "expr": "cloudflow_app_response_time_milliseconds{project=~\"$project\",environment=~\"$environment\"}",
          "legendFormat": "{{project}} \u00b7 {{environment}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Network received (rate)",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cloudflow-prometheus"
          },
          "expr": "rate(cloudflow_app_network_received_bytes{project=~\"$project\",environment=~\"$environment\"}[5m])",
          "legendFormat": "{{project}} \u00b7 {{environment}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Uptime",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cloudflow-prometheus"
          },
          "expr": "cloudflow_app_uptime_seconds{project=~\"$project\",environment=~\"$environment\"}",
          "legendFormat": "{{project}} \u00b7 {{environment}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Network sent (rate)",
      "datasource": {
        "type": "prometheus",
        "uid": "cloudflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cloudflow-prometheus"
          },
          "expr": "rate(cloudflow_app_network_transmitted_bytes{project=~\"$project\",environment=~\"$environment\"}[5m])",
          "legendFormat": "{{project}} \u00b7 {{environment}}"
        }
      ]
    }
  ]
}