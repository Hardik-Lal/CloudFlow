# Copy to infrastructure/.env and adjust. Never commit the real .env file.
CLOUDFLOW_ENVIRONMENT=local

POSTGRES_DB=cloudflow
POSTGRES_USER=cloudflow
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# GitHub OAuth App (https://github.com/settings/developers -> OAuth Apps -> New OAuth App)
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Generate each with: openssl rand -base64 32
CLOUDFLOW_JWT_SECRET=
CLOUDFLOW_ENCRYPTION_KEY=
# Set to true when CloudFlow is served over HTTPS.
CLOUDFLOW_COOKIE_SECURE=false

FRONTEND_URL=http://localhost:3000

# Deployment engine
REGISTRY_PORT=5000
# Group id owning /var/run/docker.sock inside containers: 0 on Docker Desktop,
# on Linux use: getent group docker | cut -d: -f3
DOCKER_SOCKET_GID=0
# Host name users open deployed applications with (http://<host>:<published port>).
CLOUDFLOW_PUBLIC_HOST=localhost

# CI/CD: optional secret for the GitHub webhook (repository Settings -> Webhooks, events
# "Workflow runs" and "Workflow jobs", URL <PUBLIC_API_BASE_URL>/api/v1/webhooks/github).
# Generate with: openssl rand -hex 32. Leave empty to rely on on-demand sync only.
CLOUDFLOW_GITHUB_WEBHOOK_SECRET=
BACKEND_PORT=8080
FRONTEND_PORT=3000
PUBLIC_API_BASE_URL=http://localhost:8080

# Monitoring (Prometheus always runs; Grafana with: docker compose --profile grafana up -d)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=change-me

# AI assistant (Phase 8)
# Shared secret between the backend and the AI service. Generate with: openssl rand -hex 32
CLOUDFLOW_AI_INTERNAL_TOKEN=
# OpenAI API key (https://platform.openai.com/api-keys). Empty = AI features disabled.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Security (Phase 9) ---
# Scan every built image with Trivy before it is pushed and deployed.
CLOUDFLOW_SCAN_ENABLED=true
# Fail deployments whose image has CRITICAL vulnerabilities (otherwise they are only reported).
CLOUDFLOW_SCAN_BLOCK_ON_CRITICAL=false
# Per-client API rate limits (429 + Retry-After when exceeded).
CLOUDFLOW_RATE_LIMIT_ENABLED=true

# --- Kubernetes target (Phase 10) ---
# true after starting the local cluster: docker compose --profile kubernetes up -d
CLOUDFLOW_KUBERNETES_ENABLED=false

# --- Artifact storage (Phase 10) ---
# Credentials of the local S3-compatible store (object-storage service), e.g. openssl rand -hex 16 / 32.
# In AWS: set CLOUDFLOW_S3_ENDPOINT= (empty), CLOUDFLOW_S3_PATH_STYLE=false, your bucket and region,
# and leave the keys empty to use the EC2 instance role.
CLOUDFLOW_S3_ACCESS_KEY=
CLOUDFLOW_S3_SECRET_KEY=
CLOUDFLOW_S3_BUCKET=cloudflow-artifacts
CLOUDFLOW_S3_REGION=us-east-1
CLOUDFLOW_STORAGE_ENABLED=true
